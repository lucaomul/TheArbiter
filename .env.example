# Groq API key used for Groq-hosted models
GROQ_API_KEY=your_groq_api_key_here

# OpenAI API key used for OpenAI-hosted models
OPENAI_API_KEY=your_openai_api_key_here

# Gemini API key used for Google Gemini models
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic API key used for Claude models
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional local Ollama server URL for sandbox/local model testing
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional: enable automatic provider model catalog refresh (1 = on, 0 = off)
ARBITER_ENABLE_MODEL_SYNC=1

# Optional: refresh provider model catalog every N hours
ARBITER_MODEL_SYNC_HOURS=12

# Optional: per-provider model sync timeout in seconds
ARBITER_MODEL_SYNC_TIMEOUT_SECONDS=6
